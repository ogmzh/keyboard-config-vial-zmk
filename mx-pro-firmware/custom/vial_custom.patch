diff --git a/keyboards/keebart/corne_mx_pro/keymaps/vial_custom/macro_morph.c b/keyboards/keebart/corne_mx_pro/keymaps/vial_custom/macro_morph.c
new file mode 100644
index 00000000..037efc4f
--- /dev/null
+++ b/keyboards/keebart/corne_mx_pro/keymaps/vial_custom/macro_morph.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+/* A macro key that runs a second macro while a modifier is active (ZMK calls this a mod-morph).
+
+   The pair is stored as a normal Vial key override: trigger = the macro key, replacement = the other macro.
+   Stock firmware never acts on such an entry, because a macro key is sent before key overrides are looked at.
+   Here the entry is read when the macro key goes down. If it applies, its suppressed modifiers are taken out of
+   the report while the replacement macro runs, so that for example a dead key goes out without Shift. */
+
+#include "quantum.h"
+#include "vial.h"
+#include "dynamic_keymap.h"
+#include "process_key_override.h"
+#include "caps_word.h"
+
+/* the same test as key_override_matches_active_modifiers() in process_key_override.c */
+static bool mods_match(const vial_key_override_entry_t *entry, uint8_t mods) {
+    if ((entry->negative_mod_mask & mods) != 0) return false;
+    if (entry->trigger_mods == 0) return true;
+    if ((entry->options & vial_ko_option_one_mod) != 0) return (entry->trigger_mods & mods) != 0;
+
+    /* every wanted modifier must be down, on either side when both sides are named */
+    const uint8_t wanted = (entry->trigger_mods & 0x0F) | (entry->trigger_mods >> 4);
+    const uint8_t active = entry->trigger_mods & mods;
+    return ((active & 0x0F) | (active >> 4)) == wanted;
+}
+
+static bool find_morph(uint16_t keycode, uint8_t layer, uint8_t mods, vial_key_override_entry_t *entry) {
+    for (uint8_t i = 0; i < VIAL_KEY_OVERRIDE_ENTRIES; ++i) {
+        if (dynamic_keymap_get_key_override(i, entry) != 0) continue;
+        if ((entry->options & vial_ko_enabled) == 0) continue;
+        if ((entry->options & vial_ko_option_activation_trigger_down) == 0) continue;
+        if (entry->trigger != keycode) continue;
+        if (!IS_QK_MACRO(entry->replacement)) continue;
+        if (entry->replacement - QK_MACRO >= dynamic_keymap_macro_get_count()) continue;
+        if ((entry->layers & (1 << layer)) == 0) continue;
+        if (!mods_match(entry, mods)) continue;
+        return true;
+    }
+    return false;
+}
+
+bool process_record_user(uint16_t keycode, keyrecord_t *record) {
+    /* only a macro key that is pressed on the keyboard itself; combos, tap dances and macros that send a macro
+       key have no place in the matrix, so no layer to test, and they stay as they are */
+    if (!record->event.pressed || !IS_QK_MACRO(keycode)) return true;
+    if (record->event.type != KEY_EVENT || record->event.key.row >= MATRIX_ROWS || record->event.key.col >= MATRIX_COLS) return true;
+    if (keycode - QK_MACRO >= dynamic_keymap_macro_get_count()) return true;
+    if (!key_override_is_enabled()) return true;
+
+    /* held modifiers, one-shot modifiers (pending or locked), and caps word counts as Shift.
+       Known limit: with caps word on, a Shift key held as well makes normal letters lower case
+       (CAPS_WORD_INVERT_ON_SHIFT). Caps word keeps that Shift to itself, so it cannot be seen here, and this key
+       still runs the second macro. */
+    uint8_t mods = get_mods() | get_oneshot_mods() | get_oneshot_locked_mods();
+    if (is_caps_word_on()) mods |= MOD_BIT(KC_LSFT);
+
+    vial_key_override_entry_t entry;
+    if (!find_morph(keycode, read_source_layers_cache(record->event.key), mods, &entry)) return true;
+
+    /* take the suppressed modifiers out of the report: a pending one-shot is used up, held ones come back after */
+    const uint8_t held = get_mods() & entry.suppressed_mods;
+    del_mods(held);
+    del_weak_mods(entry.suppressed_mods);
+    del_oneshot_mods(entry.suppressed_mods);
+    send_keyboard_report();
+
+    dynamic_keymap_macro_send(entry.replacement - QK_MACRO);
+
+    add_mods(held);
+    send_keyboard_report();
+    return false;
+}
