@@ -0,0 +1,464 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// keyboards/keebart/corne_mx_pro/keymaps/vial_custom/macro_morph.c: a macro key that runs a second macro while a
+// modifier is active. The handler itself is compiled in; the Vial storage and the macro player are stand-ins.
+
+#include "keyboard_report_util.hpp"
+#include "keycode.h"
+#include "test_common.hpp"
+#include "test_fixture.hpp"
+#include "test_keymap_key.hpp"
+
+extern "C" {
+#define _Static_assert static_assert // vial.h is a C header
+#include "vial.h"
+#include "caps_word.h"
+#include "process_key_override.h"
+}
+
+using testing::_;
+using testing::AnyNumber;
+using testing::InSequence;
+
+namespace {
+
+const uint16_t LOWER = QK_MACRO + 2; // the macro on the key
+const uint16_t UPPER = QK_MACRO + 5; // the macro to run with Shift
+
+vial_key_override_entry_t entries[VIAL_KEY_OVERRIDE_ENTRIES];
+int                       sent_macro;        // -1: the macro player was not called
+uint8_t                   mods_during_macro; // modifiers a key sent by the macro would have carried
+
+// what Keymap Bridge writes for: mod-morph, bindings <lower macro> <upper macro>, mods <LSFT|RSFT>
+vial_key_override_entry_t shift_morph(uint16_t layers) {
+    vial_key_override_entry_t e = {};
+    e.trigger           = LOWER;
+    e.replacement       = UPPER;
+    e.layers            = layers;
+    e.trigger_mods      = MOD_MASK_SHIFT;
+    e.negative_mod_mask = 0;
+    e.suppressed_mods   = MOD_MASK_SHIFT;
+    e.options           = 0x87;
+    return e;
+}
+
+} // namespace
+
+extern "C" {
+int dynamic_keymap_get_key_override(uint8_t index, vial_key_override_entry_t *entry) {
+    if (index >= VIAL_KEY_OVERRIDE_ENTRIES) return -1;
+    *entry = entries[index];
+    return 0;
+}
+
+uint8_t dynamic_keymap_macro_get_count(void) {
+    return 16;
+}
+
+// Like the user's macro for the capital letter: lets go of both Shift keys, then types.
+void dynamic_keymap_macro_send(uint8_t id) {
+    sent_macro        = id;
+    mods_during_macro = get_mods() | get_weak_mods() | get_oneshot_mods();
+    unregister_code(KC_LSFT);
+    unregister_code(KC_RSFT);
+    tap_code(KC_U);
+}
+}
+
+class VialCustomMacroMorph : public TestFixture {
+   public:
+    VialCustomMacroMorph() {
+        memset(entries, 0, sizeof(entries));
+        entries[1]        = shift_morph(1 << 0); // not the first entry: the search must go on past an empty one
+        sent_macro        = -1;
+        mods_during_macro = 0;
+        key_override_on();
+        caps_word_off();
+    }
+};
+
+TEST_F(VialCustomMacroMorph, without_a_modifier_the_key_is_left_alone) {
+    TestDriver driver;
+    InSequence s;
+    auto       macro_key = KeymapKey(0, 3, 0, LOWER);
+
+    set_keymap({macro_key});
+
+    EXPECT_NO_REPORT(driver);
+    tap_key(macro_key);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, -1);
+}
+
+// What the handler answers decides whether the firmware goes on to send the key's own macro: true = go on.
+TEST_F(VialCustomMacroMorph, the_handler_hands_the_key_on_unless_it_ran_the_second_macro) {
+    TestDriver driver;
+    auto       macro_key = KeymapKey(0, 3, 0, LOWER);
+
+    set_keymap({macro_key});
+    EXPECT_ANY_REPORT(driver).Times(AnyNumber());
+
+    keyrecord_t press       = {};
+    press.event.key.row     = 0;
+    press.event.key.col     = 3;
+    press.event.pressed     = true;
+    press.event.type        = KEY_EVENT;
+    press.event.time        = 1;
+    keyrecord_t release     = press;
+    release.event.pressed   = false;
+
+    EXPECT_TRUE(process_record_user(LOWER, &press)); // no Shift
+    EXPECT_EQ(sent_macro, -1);
+
+    add_mods(MOD_BIT(KC_LSFT));
+    EXPECT_FALSE(process_record_user(LOWER, &press)); // Shift: the second macro ran, the key's own must not
+    EXPECT_EQ(sent_macro, 5);
+    EXPECT_EQ(get_mods(), MOD_BIT(KC_LSFT));
+
+    sent_macro = -1;
+    EXPECT_TRUE(process_record_user(LOWER, &release)); // the release is never touched
+    EXPECT_TRUE(process_record_user(UPPER, &press));   // a macro key without an entry
+    EXPECT_TRUE(process_record_user(KC_C, &press));    // not a macro key
+    EXPECT_EQ(sent_macro, -1);
+
+    // a key with a macro number this keyboard does not have: stock firmware sends nothing for it, so nor does this
+    entries[2]         = shift_morph(1 << 0);
+    entries[2].trigger = QK_MACRO + 16;
+    EXPECT_TRUE(process_record_user(QK_MACRO + 16, &press));
+    EXPECT_EQ(sent_macro, -1);
+
+    del_mods(MOD_BIT(KC_LSFT));
+    send_keyboard_report();
+    VERIFY_AND_CLEAR(driver);
+}
+
+// A locked one-shot Shift (ONESHOT_TAP_TOGGLE) is a held Shift for the firmware: it stays locked after the macro.
+TEST_F(VialCustomMacroMorph, locked_one_shot_shift_is_held_back_and_stays_locked) {
+    TestDriver driver;
+    InSequence s;
+    auto       macro_key  = KeymapKey(0, 3, 0, LOWER);
+    auto       letter_key = KeymapKey(0, 4, 0, KC_C);
+
+    set_keymap({macro_key, letter_key});
+
+    EXPECT_REPORT(driver, (KC_LSFT));
+    set_oneshot_locked_mods(MOD_BIT(KC_LSFT));
+    register_mods(MOD_BIT(KC_LSFT));
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_U));
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_LSFT));
+    tap_key(macro_key);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, 5);
+    EXPECT_EQ(mods_during_macro, 0);
+    EXPECT_EQ(get_oneshot_locked_mods(), MOD_BIT(KC_LSFT));
+
+    EXPECT_REPORT(driver, (KC_LSFT, KC_C));
+    EXPECT_REPORT(driver, (KC_LSFT));
+    tap_key(letter_key);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    clear_oneshot_locked_mods();
+    unregister_mods(MOD_BIT(KC_LSFT));
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomMacroMorph, held_mod_tap_shift_runs_the_second_macro_without_shift_and_shift_comes_back) {
+    TestDriver driver;
+    InSequence s;
+    auto       shift_key  = KeymapKey(0, 1, 0, SFT_T(KC_A));
+    auto       macro_key  = KeymapKey(0, 3, 0, LOWER);
+    auto       letter_key = KeymapKey(0, 4, 0, KC_C);
+
+    set_keymap({shift_key, macro_key, letter_key});
+
+    EXPECT_REPORT(driver, (KC_LSFT));
+    shift_key.press();
+    idle_for(TAPPING_TERM + 1);
+    VERIFY_AND_CLEAR(driver);
+
+    // Shift goes up, the macro types without it, Shift comes back
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_U));
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_LSFT));
+    macro_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, 5);
+    EXPECT_EQ(mods_during_macro, 0);
+
+    EXPECT_NO_REPORT(driver);
+    macro_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    // the next letter is still shifted while the key stays down
+    EXPECT_REPORT(driver, (KC_LSFT, KC_C));
+    EXPECT_REPORT(driver, (KC_LSFT));
+    tap_key(letter_key);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    shift_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_C));
+    EXPECT_EMPTY_REPORT(driver);
+    tap_key(letter_key);
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomMacroMorph, plain_right_shift_works_the_same) {
+    TestDriver driver;
+    InSequence s;
+    auto       shift_key = KeymapKey(0, 1, 0, KC_RSFT);
+    auto       macro_key = KeymapKey(0, 3, 0, LOWER);
+
+    set_keymap({shift_key, macro_key});
+
+    EXPECT_REPORT(driver, (KC_RSFT));
+    shift_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_U));
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_RSFT));
+    tap_key(macro_key);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, 5);
+    EXPECT_EQ(mods_during_macro, 0);
+
+    EXPECT_EMPTY_REPORT(driver);
+    shift_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomMacroMorph, one_shot_shift_is_used_up_by_the_macro) {
+    TestDriver driver;
+    InSequence s;
+    auto       osm_key    = KeymapKey(0, 1, 0, OSM(MOD_LSFT), KC_LSFT);
+    auto       macro_key  = KeymapKey(0, 3, 0, LOWER);
+    auto       letter_key = KeymapKey(0, 4, 0, KC_C);
+
+    set_keymap({osm_key, macro_key, letter_key});
+
+    EXPECT_NO_REPORT(driver);
+    tap_key(osm_key);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(get_oneshot_mods(), MOD_BIT(KC_LSFT));
+
+    EXPECT_REPORT(driver, (KC_U));
+    EXPECT_EMPTY_REPORT(driver);
+    tap_key(macro_key);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, 5);
+    EXPECT_EQ(mods_during_macro, 0);
+    EXPECT_EQ(get_oneshot_mods(), 0);
+
+    // the letter after it is not shifted
+    EXPECT_REPORT(driver, (KC_C));
+    EXPECT_EMPTY_REPORT(driver);
+    tap_key(letter_key);
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomMacroMorph, caps_word_counts_as_shift_and_stays_on) {
+    TestDriver driver;
+    auto       macro_key  = KeymapKey(0, 3, 0, LOWER);
+    auto       letter_key = KeymapKey(0, 4, 0, KC_C);
+
+    set_keymap({macro_key, letter_key});
+    caps_word_on();
+
+    // a letter under caps word is shifted, and that Shift stays down at the computer until the next key
+    EXPECT_REPORT(driver, (KC_LSFT)).Times(AnyNumber());
+    EXPECT_REPORT(driver, (KC_LSFT, KC_C));
+    tap_key(letter_key);
+    VERIFY_AND_CLEAR(driver);
+
+    {
+        // so Shift must go up before the macro types
+        InSequence s;
+        EXPECT_EMPTY_REPORT(driver);
+        EXPECT_REPORT(driver, (KC_U));
+        EXPECT_EMPTY_REPORT(driver);
+        tap_key(macro_key);
+        VERIFY_AND_CLEAR(driver);
+    }
+    EXPECT_EQ(sent_macro, 5);
+    EXPECT_EQ(mods_during_macro, 0);
+    EXPECT_EQ(is_caps_word_on(), true);
+
+    EXPECT_REPORT(driver, (KC_LSFT)).Times(AnyNumber());
+    EXPECT_REPORT(driver, (KC_LSFT, KC_C));
+    tap_key(letter_key);
+    VERIFY_AND_CLEAR(driver);
+
+    caps_word_off();
+}
+
+TEST_F(VialCustomMacroMorph, only_the_suppressed_modifiers_are_held_back) {
+    TestDriver driver;
+    InSequence s;
+    auto       ctrl_key  = KeymapKey(0, 0, 0, KC_LCTL);
+    auto       shift_key = KeymapKey(0, 1, 0, KC_LSFT);
+    auto       macro_key = KeymapKey(0, 3, 0, LOWER);
+
+    set_keymap({ctrl_key, shift_key, macro_key});
+
+    EXPECT_REPORT(driver, (KC_LCTL));
+    EXPECT_REPORT(driver, (KC_LCTL, KC_LSFT));
+    ctrl_key.press();
+    run_one_scan_loop();
+    shift_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_LCTL));
+    EXPECT_REPORT(driver, (KC_LCTL, KC_U));
+    EXPECT_REPORT(driver, (KC_LCTL));
+    EXPECT_REPORT(driver, (KC_LCTL, KC_LSFT));
+    tap_key(macro_key);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, 5);
+    EXPECT_EQ(mods_during_macro, MOD_BIT(KC_LCTL));
+
+    EXPECT_REPORT(driver, (KC_LCTL));
+    EXPECT_EMPTY_REPORT(driver);
+    shift_key.release();
+    run_one_scan_loop();
+    ctrl_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomMacroMorph, another_modifier_alone_does_nothing) {
+    TestDriver driver;
+    InSequence s;
+    auto       ctrl_key  = KeymapKey(0, 0, 0, KC_LCTL);
+    auto       macro_key = KeymapKey(0, 3, 0, LOWER);
+
+    set_keymap({ctrl_key, macro_key});
+
+    EXPECT_REPORT(driver, (KC_LCTL));
+    ctrl_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    tap_key(macro_key);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, -1);
+
+    EXPECT_EMPTY_REPORT(driver);
+    ctrl_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomMacroMorph, the_entry_applies_on_its_own_layer_only) {
+    TestDriver driver;
+    InSequence s;
+    auto       shift_key  = KeymapKey(0, 1, 0, KC_LSFT);
+    auto       layer_key  = KeymapKey(0, 2, 0, MO(1));
+    auto       base_macro = KeymapKey(0, 3, 0, LOWER);
+    auto       top_macro  = KeymapKey(1, 4, 0, LOWER);
+
+    set_keymap({shift_key, layer_key, base_macro, top_macro, KeymapKey(1, 1, 0, KC_TRNS), KeymapKey(1, 2, 0, KC_TRNS)});
+    entries[1] = shift_morph(1 << 1);
+
+    EXPECT_REPORT(driver, (KC_LSFT));
+    shift_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    // on layer 0: not this entry's layer
+    EXPECT_NO_REPORT(driver);
+    tap_key(base_macro);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, -1);
+
+    // on layer 1
+    EXPECT_NO_REPORT(driver);
+    layer_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_U));
+    EXPECT_EMPTY_REPORT(driver);
+    EXPECT_REPORT(driver, (KC_LSFT));
+    tap_key(top_macro);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_EQ(sent_macro, 5);
+
+    EXPECT_EMPTY_REPORT(driver);
+    layer_key.release();
+    run_one_scan_loop();
+    shift_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomMacroMorph, entries_that_must_not_apply) {
+    TestDriver driver;
+    InSequence s;
+    auto       shift_key = KeymapKey(0, 1, 0, KC_LSFT);
+    auto       macro_key = KeymapKey(0, 3, 0, LOWER);
+
+    set_keymap({shift_key, macro_key});
+
+    EXPECT_REPORT(driver, (KC_LSFT));
+    shift_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+
+    entries[1]         = shift_morph(1 << 0);
+    entries[1].options = 0x07; // switched off in Vial
+    tap_key(macro_key);
+    EXPECT_EQ(sent_macro, -1);
+
+    entries[1]             = shift_morph(1 << 0);
+    entries[1].replacement = KC_X; // a normal key override: left to the firmware's own code
+    tap_key(macro_key);
+    EXPECT_EQ(sent_macro, -1);
+
+    entries[1]             = shift_morph(1 << 0);
+    entries[1].replacement = QK_MACRO + 16; // a macro this keyboard does not have
+    tap_key(macro_key);
+    EXPECT_EQ(sent_macro, -1);
+
+    entries[1]         = shift_morph(1 << 0);
+    entries[1].trigger = QK_MACRO + 3; // for another macro key
+    tap_key(macro_key);
+    EXPECT_EQ(sent_macro, -1);
+
+    entries[1]                   = shift_morph(1 << 0);
+    entries[1].negative_mod_mask = MOD_BIT(KC_LSFT); // "not with Shift"
+    tap_key(macro_key);
+    EXPECT_EQ(sent_macro, -1);
+
+    entries[1] = shift_morph(1 << 0);
+    key_override_off(); // all key overrides switched off with the key for that
+    tap_key(macro_key);
+    EXPECT_EQ(sent_macro, -1);
+    key_override_on();
+
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    shift_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
