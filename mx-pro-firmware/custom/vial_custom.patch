+// Here: the combo layer key is tapped, then held, then the "-" combo is tapped, all behind an undecided home-row
+// key. The "-" combo's release must not be taken for the layer key's release (a second Tab).
+// (The key at column 0, row 0 is mapped because stock code looks that position up for a key that comes from a
+// combo, for one in process_record_tap_hint(); the fixture fails on a lookup of an unmapped position.)
+TEST_F(VialCustomLayerTap, combo_layer_key_tapped_then_held_is_not_mixed_up_with_another_combo) {
+    TestDriver driver;
+    InSequence s;
+    auto       mod_tap_key = KeymapKey(0, 5, 0, SFT_T(KC_A));
+    auto       key_q       = KeymapKey(0, 0, 1, KC_Q);
+    auto       key_w       = KeymapKey(0, 1, 1, KC_W);
+    auto       key_e       = KeymapKey(0, 2, 1, KC_E);
