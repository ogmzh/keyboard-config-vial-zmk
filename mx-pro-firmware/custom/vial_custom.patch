+    set_keymap({mod_tap_key, key_q, key_w, key_e, key_r, KeymapKey(0, 0, 0, KC_ESC), KeymapKey(1, 0, 0, KC_TRNS), KeymapKey(1, 5, 0, KC_TRNS), KeymapKey(1, 0, 1, KC_TRNS), KeymapKey(1, 1, 1, KC_TRNS), KeymapKey(1, 2, 1, KC_TRNS), KeymapKey(1, 3, 1, KC_TRNS)});
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(500);
+    mod_tap_key.press();
+    idle_for(20);
+    key_q.press(); // layer key down
+    run_one_scan_loop();
+    key_w.press();
+    idle_for(24);
+    key_q.release(); // layer key up
+    run_one_scan_loop();
+    key_w.release();
+    idle_for(14);
+    key_q.press(); // layer key down again
+    run_one_scan_loop();
+    key_w.press();
+    idle_for(24);
+    key_e.press(); // "-" down
+    run_one_scan_loop();
+    key_r.press();
+    idle_for(24);
+    key_e.release(); // "-" up
+    run_one_scan_loop();
+    key_r.release();
+    idle_for(19);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_REPORT(driver, (KC_A, KC_TAB));
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_REPORT(driver, (KC_A, KC_MINS));
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_EMPTY_REPORT(driver);
+    mod_tap_key.release(); // at 130 ms
+    idle_for(100);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_TRUE(layer_state_is(1));
+
+    EXPECT_NO_REPORT(driver);
+    key_q.release();
+    run_one_scan_loop();
+    key_w.release();
+    idle_for(TAPPING_TERM * 2);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_FALSE(layer_state_is(1));
+    EXPECT_EQ(get_mods(), 0);
+}
+
+// The combo layer key, the combo Ctrl/2 key and the "-" combo, all behind an undecided home-row key. The layer key
+// takes its layer, and "-" waits until Ctrl is settled: Ctrl + "-", not "-" and then Ctrl.
+TEST_F(VialCustomLayerTap, combo_keys_behind_an_undecided_mod_tap_keep_the_order) {
+    TestDriver driver;
+    InSequence s;
+    auto       mod_tap_key = KeymapKey(0, 5, 0, SFT_T(KC_A));
+    auto       key_q       = KeymapKey(0, 0, 1, KC_Q);
+    auto       key_w       = KeymapKey(0, 1, 1, KC_W);
+    auto       key_e       = KeymapKey(0, 2, 1, KC_E);
+    auto       key_r       = KeymapKey(0, 3, 1, KC_R);
+    auto       key_t       = KeymapKey(0, 4, 1, KC_T);
+    auto       key_y       = KeymapKey(0, 5, 1, KC_Y);
+
+    set_keymap({mod_tap_key, key_q, key_w, key_e, key_r, key_t, key_y, KeymapKey(0, 0, 0, KC_ESC), KeymapKey(1, 0, 0, KC_TRNS), KeymapKey(1, 5, 0, KC_TRNS), KeymapKey(1, 0, 1, KC_TRNS), KeymapKey(1, 1, 1, KC_TRNS), KeymapKey(1, 2, 1, KC_TRNS), KeymapKey(1, 3, 1, KC_TRNS), KeymapKey(1, 4, 1, KC_TRNS),
+                KeymapKey(1, 5, 1, KC_TRNS)});
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(500);
+    mod_tap_key.press();
+    idle_for(20);
+    key_q.press(); // layer key down
+    run_one_scan_loop();
+    key_w.press();
+    idle_for(19);
+    key_t.press(); // Ctrl/2 down, at about 40 ms
+    run_one_scan_loop();
+    key_y.press();
+    idle_for(19);
+    key_e.press(); // "-" down
+    run_one_scan_loop();
+    key_r.press();
+    idle_for(24);
+    VERIFY_AND_CLEAR(driver);
+
+    // The home-row key is "a". Nothing more until Ctrl is settled.
+    EXPECT_REPORT(driver, (KC_A));
+    mod_tap_key.release(); // at 85 ms
+    idle_for(15);
+    key_e.release(); // "-" up
+    run_one_scan_loop();
+    key_r.release();
+    idle_for(99);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_TRUE(layer_state_is(1));
+
+    // Ctrl's term runs out at about 250 ms: Ctrl, "-" with it, then the releases that waited, in order
+    EXPECT_REPORT(driver, (KC_LCTL, KC_A));
+    EXPECT_REPORT(driver, (KC_LCTL, KC_A, KC_MINS));
+    EXPECT_REPORT(driver, (KC_LCTL, KC_MINS));
+    EXPECT_REPORT(driver, (KC_LCTL));
+    idle_for(100);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    key_t.release();
+    run_one_scan_loop();
+    key_y.release();
+    idle_for(20);
+    key_q.release();
+    run_one_scan_loop();
+    key_w.release();
+    idle_for(TAPPING_TERM * 2);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_FALSE(layer_state_is(1));
+    EXPECT_EQ(get_mods(), 0);
+}
+
+// Home-row mods are as before: a letter rolled over a mod-tap inside the tapping term is two letters.
+TEST_F(VialCustomLayerTap, mod_tap_is_still_tap_preferred) {
+    TestDriver driver;
+    InSequence s;
+    auto       mod_tap_key = KeymapKey(0, 5, 0, SFT_T(KC_A));
+    auto       letter_key  = KeymapKey(0, 6, 0, KC_C);
+
+    set_keymap({mod_tap_key, letter_key});
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(500);
+    mod_tap_key.press();
+    idle_for(30);
+    letter_key.press();
+    idle_for(30);
+    letter_key.release();
+    idle_for(30);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_REPORT(driver, (KC_A, KC_C));
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_EMPTY_REPORT(driver);
+    mod_tap_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomLayerTap, mod_tap_held_past_the_term_is_the_modifier) {
+    TestDriver driver;
+    InSequence s;
+    auto       mod_tap_key = KeymapKey(0, 5, 0, SFT_T(KC_A));
+    auto       letter_key  = KeymapKey(0, 6, 0, KC_C);
+
+    set_keymap({mod_tap_key, letter_key});
+
+    EXPECT_REPORT(driver, (KC_LSFT));
+    idle_for(500);
+    mod_tap_key.press();
+    idle_for(TAPPING_TERM + 1);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_LSFT, KC_C));
+    letter_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_LSFT));
+    letter_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    mod_tap_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
