+    idle_for(TAPPING_TERM + 1);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    mod_tap_key.press();
+    idle_for(20);
+    alt_key.press();
+    idle_for(20);
+    ctrl_key.release();
+    idle_for(20);
+    letter_key.press();
+    idle_for(20);
