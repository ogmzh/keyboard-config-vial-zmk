+#ifdef QS_LAYER_TAP_HOLD_PREFERRED
+    /* a layer-tap key takes its layer as soon as another key is pressed; mod-taps keep the setting */
+    if (IS_QK_LAYER_TAP(keycode)) return true;
+#endif
