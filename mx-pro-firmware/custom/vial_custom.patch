+
+#define VIAL_UNLOCK_COMBO_ROWS {0, 0}
+#define VIAL_UNLOCK_COMBO_COLS {0, 1}
+
+/* Layer-tap keys take their layer as soon as another key is pressed, and a quick second press is a new press.
+   Mod-taps keep the Vial settings. See get_hold_on_other_key_press() and get_quick_tap_term() in
+   quantum/qmk_settings.c. */
+#define QS_LAYER_TAP_HOLD_PREFERRED
