+
+// clang-format off
+combo_t key_combos[] = {
+    [combo_layer_tap] = COMBO(combo_layer_tap_keys, LT(1, KC_TAB)),
+    [combo_mod_tap]   = COMBO(combo_mod_tap_keys, CTL_T(KC_2)),
+    [combo_plain]     = COMBO(combo_plain_keys, KC_MINS),
+};
+// clang-format on
diff --git a/tests/vial_custom_layer_tap/test_layer_tap.cpp b/tests/vial_custom_layer_tap/test_layer_tap.cpp
new file mode 100644
index 00000000..c6c2f948
--- /dev/null
+++ b/tests/vial_custom_layer_tap/test_layer_tap.cpp
@@ -0,0 +1,978 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// The tap-hold rule of the vial_custom keymap for keebart/corne_mx_pro: a layer-tap key takes its layer as soon
+// as another key goes down, a mod-tap does not.
+
+#include "keyboard_report_util.hpp"
+#include "keycode.h"
+#include "test_common.hpp"
+#include "action_tapping.h"
+#include "action_layer.h"
+#include "test_fixture.hpp"
+#include "test_keymap_key.hpp"
+
+using testing::_;
+using testing::InSequence;
+
+// What quantum/qmk_settings.c answers in that build (QS_LAYER_TAP_HOLD_PREFERRED) with these Vial settings:
+// permissive hold, hold on other key press, retro tapping and chordal hold off, quick tap 80 ms, flow tap 60 ms.
+// Vial's own "hold on other key press" switch, for every tap-hold key. Off for the owner; one case turns it on.
+static bool hold_on_other_key_press_for_all = false;
+
+extern "C" {
+bool get_hold_on_other_key_press(uint16_t keycode, keyrecord_t *record) {
+    if (IS_QK_LAYER_TAP(keycode)) return true;
+    return hold_on_other_key_press_for_all;
+}
+
+uint16_t get_quick_tap_term(uint16_t keycode, keyrecord_t *record) {
+    if (IS_QK_LAYER_TAP(keycode)) return 0;
+    return 80;
+}
+
+bool get_permissive_hold(uint16_t keycode, keyrecord_t *record) {
+    return false;
+}
+
+bool get_retro_tapping(uint16_t keycode, keyrecord_t *record) {
+    return false;
+}
+
+bool get_chordal_hold(uint16_t tap_hold_keycode, keyrecord_t *tap_hold_record, uint16_t other_keycode, keyrecord_t *other_record) {
+    return true;
+}
+
+uint16_t get_flow_tap_term(uint16_t keycode, keyrecord_t *record, uint16_t prev_keycode) {
+    if (is_flow_tap_key(keycode) && is_flow_tap_key(prev_keycode)) return 60;
+    return 0;
+}
+}
+
+class VialCustomLayerTap : public TestFixture {
+  public:
+    ~VialCustomLayerTap() {
+        hold_on_other_key_press_for_all = false;
+    }
+};
+
+// A note on key positions: the firmware remembers, per position, the layer of the last press (also from one case
+// to the next), and the fixture fails on a lookup of a position that a case has not mapped on that layer. So a
+// case that maps fewer layers than an earlier one uses positions of its own.
+
+// The report from the user: thumb down, C down, C up, thumb up, all inside the tapping term, must give "-".
+TEST_F(VialCustomLayerTap, layer_key_takes_its_layer_when_another_key_goes_down) {
+    TestDriver driver;
+    InSequence s;
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+    auto       letter_key    = KeymapKey(0, 2, 0, KC_C);
+    auto       layer_key     = KeymapKey(1, 2, 0, KC_MINS);
+
+    set_keymap({layer_tap_key, letter_key, layer_key});
+
+    EXPECT_NO_REPORT(driver);
+    layer_tap_key.press();
+    idle_for(30);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_MINS));
+    letter_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    idle_for(30);
+    letter_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_TRUE(layer_state_is(1));
+    EXPECT_NO_REPORT(driver);
+    idle_for(30);
+    layer_tap_key.release();
+    run_one_scan_loop();
+    idle_for(TAPPING_TERM * 2);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_FALSE(layer_state_is(1));
+
+    // and the letter key is the letter again
+    EXPECT_REPORT(driver, (KC_C));
+    EXPECT_EMPTY_REPORT(driver);
+    tap_key(letter_key);
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(VialCustomLayerTap, layer_key_let_go_first_still_gives_the_layer_key) {
+    TestDriver driver;
+    InSequence s;
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+    auto       letter_key    = KeymapKey(0, 2, 0, KC_C);
+    auto       layer_key     = KeymapKey(1, 2, 0, KC_MINS);
+
+    set_keymap({layer_tap_key, letter_key, layer_key});
+
+    EXPECT_NO_REPORT(driver);
+    layer_tap_key.press();
+    idle_for(30);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_MINS));
+    letter_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    layer_tap_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    letter_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_FALSE(layer_state_is(1));
+}
+
+TEST_F(VialCustomLayerTap, layer_key_alone_is_a_tap) {
+    TestDriver driver;
+    InSequence s;
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+
+    set_keymap({layer_tap_key});
+
+    EXPECT_NO_REPORT(driver);
+    layer_tap_key.press();
+    idle_for(100);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_TAB));
+    EXPECT_EMPTY_REPORT(driver);
+    layer_tap_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+// With the 80 ms quick tap term of the other keys, the second press would hold Tab down and C would give "c".
+TEST_F(VialCustomLayerTap, layer_key_again_right_after_a_tap_is_a_new_press) {
+    TestDriver driver;
+    InSequence s;
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+    auto       letter_key    = KeymapKey(0, 2, 0, KC_C);
+    auto       layer_key     = KeymapKey(1, 2, 0, KC_MINS);
+
+    set_keymap({layer_tap_key, letter_key, layer_key});
+
+    EXPECT_REPORT(driver, (KC_TAB));
+    EXPECT_EMPTY_REPORT(driver);
+    tap_key(layer_tap_key, 20);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(20);
+    layer_tap_key.press();
+    idle_for(20);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_MINS));
+    letter_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    letter_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    layer_tap_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+// Flow tap (a tap-hold key pressed right after a letter is a tap) must not reach the layer keys.
+TEST_F(VialCustomLayerTap, layer_key_right_after_a_letter_still_takes_its_layer) {
+    TestDriver driver;
+    InSequence s;
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+    auto       letter_key    = KeymapKey(0, 2, 0, KC_C);
+    auto       layer_key     = KeymapKey(1, 2, 0, KC_MINS);
+
+    set_keymap({layer_tap_key, letter_key, layer_key});
+
+    EXPECT_REPORT(driver, (KC_C));
+    EXPECT_EMPTY_REPORT(driver);
+    tap_key(letter_key, 10);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(10);
+    layer_tap_key.press();
+    idle_for(10);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_MINS));
+    letter_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    letter_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    layer_tap_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+// A home-row mod is still undecided (down, inside its term) while the layer key and the letter are typed. All of it
+// waits in the queue behind the mod-tap; when that is settled, the layer key must still take its layer.
+// Found in review: before the change in waiting_buffer_scan_tap() this gave "a", Tab, "c".
+TEST_F(VialCustomLayerTap, layer_key_typed_behind_an_undecided_mod_tap_still_takes_its_layer) {
+    TestDriver driver;
+    InSequence s;
+    auto       mod_tap_key   = KeymapKey(0, 5, 0, SFT_T(KC_A));
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+    auto       letter_key    = KeymapKey(0, 2, 0, KC_C);
+    auto       layer_key     = KeymapKey(1, 2, 0, KC_MINS);
+
+    set_keymap({mod_tap_key, layer_tap_key, letter_key, layer_key, KeymapKey(1, 1, 0, KC_TRNS), KeymapKey(1, 5, 0, KC_TRNS)});
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(500);
+    mod_tap_key.press();
+    idle_for(20);
+    layer_tap_key.press();
+    idle_for(20);
+    letter_key.press();
+    idle_for(20);
+    letter_key.release();
+    idle_for(20);
+    layer_tap_key.release();
+    idle_for(20);
+    VERIFY_AND_CLEAR(driver);
+
+    // the mod-tap is let go inside its term: it is the letter "a", and what waited behind it is the layer's key
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_REPORT(driver, (KC_A, KC_MINS));
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_EMPTY_REPORT(driver);
+    mod_tap_key.release();
+    idle_for(10);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_FALSE(layer_state_is(1));
+}
+
+// The same with the home-row key held on as Shift: Shift, then the layer's key with Shift.
+// Before the change this gave Shift + Tab, then "C".
+TEST_F(VialCustomLayerTap, layer_key_typed_behind_a_mod_tap_that_becomes_shift_still_takes_its_layer) {
+    TestDriver driver;
+    InSequence s;
+    auto       mod_tap_key   = KeymapKey(0, 5, 0, SFT_T(KC_A));
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+    auto       letter_key    = KeymapKey(0, 2, 0, KC_C);
+    auto       layer_key     = KeymapKey(1, 2, 0, KC_MINS);
+
+    set_keymap({mod_tap_key, layer_tap_key, letter_key, layer_key, KeymapKey(1, 1, 0, KC_TRNS), KeymapKey(1, 5, 0, KC_TRNS)});
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(500);
+    mod_tap_key.press();
+    idle_for(50);
+    layer_tap_key.press();
+    idle_for(50);
+    letter_key.press();
+    idle_for(40);
+    letter_key.release();
+    idle_for(40);
+    layer_tap_key.release();
+    idle_for(10);
+    VERIFY_AND_CLEAR(driver);
+
+    // the tapping term of the mod-tap ends: it is Shift, and what waited behind it is the layer's key
+    EXPECT_REPORT(driver, (KC_LSFT));
+    EXPECT_REPORT(driver, (KC_LSFT, KC_MINS));
+    EXPECT_REPORT(driver, (KC_LSFT));
+    idle_for(30);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_FALSE(layer_state_is(1));
+
+    EXPECT_EMPTY_REPORT(driver);
+    mod_tap_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+// No other key between its press and its release: the layer key that waited behind a mod-tap is a tap, as before.
+TEST_F(VialCustomLayerTap, layer_key_tapped_behind_an_undecided_mod_tap_is_still_a_tap) {
+    TestDriver driver;
+    InSequence s;
+    auto       mod_tap_key   = KeymapKey(0, 5, 0, SFT_T(KC_A));
+    auto       layer_tap_key = KeymapKey(0, 1, 0, LT(1, KC_TAB));
+
+    set_keymap({mod_tap_key, layer_tap_key, KeymapKey(1, 1, 0, KC_TRNS), KeymapKey(1, 5, 0, KC_TRNS)});
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(500);
+    mod_tap_key.press();
+    idle_for(20);
+    layer_tap_key.press();
+    idle_for(20);
+    layer_tap_key.release();
+    idle_for(20);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_REPORT(driver, (KC_A, KC_TAB));
+    EXPECT_REPORT(driver, (KC_A));
+    EXPECT_EMPTY_REPORT(driver);
+    mod_tap_key.release();
+    idle_for(10);
+    VERIFY_AND_CLEAR(driver);
+    EXPECT_FALSE(layer_state_is(1));
+}
+
+// A home-row key is held as Shift, the layer key goes down, Shift is let go, then the letter is typed. The firmware
+// keeps the Shift release back while the layer key is undecided. It must still be carried out when the letter
+// settles the layer key. Found in review: it was taken for the next undecided key and lost, so Shift stayed on.
